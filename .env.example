# ==========================================================
# K3 APD Monitoring System Configuration
# ==========================================================

# Flask Web Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change_this_to_a_secure_random_key

# Video Input Source
# - Use "0" for USB / Laptop Webcam
# - Use RTSP URL for IP Camera / CCTV (e.g., rtsp://user:pass@192.168.1.100:554/stream)
# - Use video file path for testing (e.g., test_footage.mp4)
VIDEO_SOURCE=0

# MySQL Database Connection String
DATABASE_URL=mysql+mysqlconnector://root:@localhost/k3monitoring

# Custom Model Paths (Optional - defaults to models/ directory)
# MODEL_PATH_DET=models/detection/yolov8_apd_best.pt
# MODEL_PATH_CLS_HELM=models/classification/klasifikasi_helm.pt
# MODEL_PATH_CLS_SEPATU=models/classification/klasifikasi_sepatu.pt
